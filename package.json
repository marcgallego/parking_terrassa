{
  "name": "parking-terrassa",
  "version": "1.0.0",
  "private": true,
  "description": "Dataset obert d'ocupació dels pàrquings Saba de Terrassa (Cloudflare Workers + D1)",
  "type": "module",
  "scripts": {
    "build": "esbuild web/app.ts --bundle --format=iife --target=es2020 --sourcemap --outfile=public/app.js",
    "typecheck": "tsc -b tsconfig.worker.json tsconfig.web.json",
    "check": "npm run typecheck && npm run build",
    "dev": "npm run build && wrangler dev --test-scheduled",
    "deploy": "npm run check && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply parking-terrassa --local",
    "db:migrate": "wrangler d1 migrations apply parking-terrassa --remote",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.131.0"
  }
}
